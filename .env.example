# Set the real HTTPS domain, without a trailing path. Rebuild after SEO changes.
SITE_URL=
# Enable only for public production, then rebuild.
SITE_INDEXABLE=false
# Gmail with 2-Step Verification and a dedicated App Password.
GMAIL_USER=station.wohlen@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_ADMIN_EMAIL=stationbar4@gmail.com
# Register hostnames in Cloudflare Turnstile. Required for production delivery.
# Public key is embedded at build time; rebuild after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
